### LITELLM PROXY VARIABLES ###

# z.ai (GLM models), read by litellm-config.yml
ZAI_API_KEY=<your_zai_api_key>

# Optional: only needed if you enable the langfuse success_callback in
# litellm-config.yml. The proxy runs fine without these.
LANGFUSE_PUBLIC_KEY=<your_langfuse_public_key>
LANGFUSE_SECRET_KEY=<your_langfuse_secret_key>
LANGFUSE_HOST=<your_langfuse_host>

### APPLICATION VARIABLES ###

# Qdrant
QDRANT_COLLECTION=sample-corpus
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Chat (via the litellm-proxy service)
CHAT_URL=http://litellm-proxy:4000
CHAT_API_KEY=None

# Embeddings (via the tei service, BAAI/bge-m3)
OPENAI_EMBEDDING_MODEL=bge-m3
EMBED_URL=http://tei:80/v1
EMBED_API_KEY=None
