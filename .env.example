POSTGRES_USER=optimizer
POSTGRES_PASSWORD=optimizer
POSTGRES_DB=ai_cost_optimizer

# Used by the backend when run outside docker-compose
DATABASE_URL=postgresql+psycopg://optimizer:optimizer@localhost:5432/ai_cost_optimizer

### examples/sample-rag-app infra (Phase 4a) ###

# z.ai API key, used by litellm-proxy to reach GLM models (glm-4.5-flash default,
# glm-5.3-flash / glm-5.3 also available). Do not commit the real value.
ZAI_API_KEY=<your_zai_api_key>

# Optional: only needed if you enable the langfuse success_callback in
# examples/sample-rag-app/litellm-config.yml. litellm-proxy starts fine without these.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Optional overrides for the sample-rag-app service
SAMPLE_RAG_QDRANT_COLLECTION=sample-corpus
SAMPLE_RAG_EMBEDDING_MODEL=bge-m3
